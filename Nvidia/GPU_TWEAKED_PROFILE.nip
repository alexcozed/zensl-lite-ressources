        <ProfileDate>2025-01-16</ProfileDate>
        <ProfileAuthor>ZenSL Optimizer</ProfileAuthor>
        <TargetApplications>All Applications</TargetApplications>
        <Compatibility>GeForce GTX 10 Series and newer</Compatibility>
        <OptimizationLevel>Maximum Performance</OptimizationLevel>
    </ProfileInfo>

    <OptimizationNotes>
